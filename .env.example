# URL для подключения к базе данных PostgreSQL (например, от Timeweb Cloud)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Секретный ключ для подписи JWT-токенов. 
# Сгенерируйте с помощью команды в терминале: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
